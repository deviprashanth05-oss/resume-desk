# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional
CLAUDE_MODEL=claude-sonnet-5
LIMIT_PER_HOUR=20          # AI calls per visitor per hour
LIMIT_PER_DAY=1500         # AI calls for the whole site per day (protects your bill)
ALLOWED_ORIGIN=            # e.g. https://yourdomain.com (blocks other sites from using your API)

# Recommended on Vercel: makes the limits reliable across servers (free tier at upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
