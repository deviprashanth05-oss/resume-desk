# ---------- Required ----------
GEMINI_API_KEY=AIza...

# ---------- MySQL database (Aiven free tier, or any managed MySQL) ----------
DB_HOST=your-service.aivencloud.com
DB_PORT=your-port
DB_USER=avnadmin
DB_PASSWORD=change-this-db-password
DB_NAME=defaultdb
# Paste the full CA certificate (PEM text, including the BEGIN/END lines) that
# Aiven gives you on the service's Overview page. Required for Aiven.
DB_SSL_CA=

# ---------- First admin (used once, when no admin exists yet) ----------
# After the first deploy, DELETE the ADMIN_PASSWORD line/variable from Vercel.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-long-password

# ---------- Optional ----------
APP_NAME=Resume Desk
SUPPORT_EMAIL=help@yourdomain.com     # shown on login page and privacy policy
GEMINI_MODEL=gemini-2.0-flash
APP_TZ=Asia/Kolkata                   # when the daily AI limit resets (midnight in this time zone)
# TRUST_PROXY=1                       # Vercel already sits behind a proxy; usually no need to set this
# COOKIE_SECURE=true                  # force Secure cookies (auto-detected behind HTTPS, which Vercel always is)
BACKUP_KEEP=14
